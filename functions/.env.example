# Not secret: SMTP parameters, configured for the verified mail domain
ECB_SMTP_HOST=smtp.provider.example
ECB_SMTP_PORT=465
ECB_SMTP_USER=postfach@ecb-system.de
ECB_MAIL_FROM=postfach@ecb-system.de
# Store the password using: firebase functions:secrets:set ECB_SMTP_PASSWORD
# The recipient is fixed server-side to pb@ecb-system.de for automatic emails.
